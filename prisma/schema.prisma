generator client {
  provider = "prisma-client"
  output   = "../src/generated/prisma"
}

datasource db {
  provider = "postgresql"
}

model PasswordResetToken {
  id        String    @id
  userId    String    @map("user_id")
  token     String    @unique
  expiresAt DateTime  @map("expires_at")
  usedAt    DateTime? @map("used_at")
  createdAt DateTime  @default(now()) @map("created_at")
  issuedIp  String?   @map("issued_ip")
  issuedUa  String?   @map("issued_ua")
  user      User      @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([userId])
  @@index([token])
  @@map("password_reset_tokens")
}

model RoleDefinition {
  id              String   @id
  code            String   @unique
  name            String
  description     String?
  orgScope        OrgScope @map("org_scope")
  branchSingleton Boolean  @map("branch_singleton")
  isSystem        Boolean  @map("is_system")
  permissions     String[]
  status          Status
  createdAt       DateTime @map("created_at")
  updatedAt       DateTime @map("updated_at")
  users           User[]

  @@map("roles")
}

model User {
  id                  String               @id
  name                String
  username            String               @unique
  email               String               @unique
  passwordHash        String               @map("password_hash")
  role                String
  status              Status
  districtId          String?              @map("district_id")
  branchId            String?              @map("branch_id")
  departmentId        String?              @map("department_id")
  createdAt           DateTime             @map("created_at")
  updatedAt           DateTime             @map("updated_at")
  lastLoginAt         DateTime?            @map("last_login_at")
  mustChangePassword  Boolean              @default(false) @map("must_change_password")
  passwordExpiresAt   DateTime?            @map("password_expires_at")
  sessionVersion      Int                  @default(1) @map("session_version")
  phone               String?
  passwordResetTokens PasswordResetToken[]
  supportThreads      SupportThread[]
  branch              Branch?              @relation(fields: [branchId], references: [id], onDelete: Restrict)
  department          Department?          @relation(fields: [departmentId], references: [id], onDelete: Restrict)
  district            District?            @relation(fields: [districtId], references: [id], onDelete: Restrict)
  roleRef             RoleDefinition       @relation(fields: [role], references: [code])

  @@map("users")
}

model District {
  id        String    @id
  code      String    @unique
  name      String
  status    Status
  createdAt DateTime  @map("created_at")
  updatedAt DateTime  @map("updated_at")
  branches  Branch[]
  findings  Finding[]
  users     User[]

  @@map("districts")
}

model Branch {
  id                  String               @id
  code                String               @unique
  name                String
  districtId          String               @map("district_id")
  status              Status
  createdAt           DateTime             @map("created_at")
  updatedAt           DateTime             @map("updated_at")
  branchCoverageNotes BranchCoverageNote[]
  district            District             @relation(fields: [districtId], references: [id])
  findings            Finding[]
  users               User[]

  @@map("branches")
}

model Source {
  id        String    @id
  code      String    @unique
  name      String
  active    Boolean
  createdAt DateTime  @map("created_at")
  updatedAt DateTime  @map("updated_at")
  isDefault Boolean   @default(false) @map("is_default")
  findings  Finding[]

  @@map("sources")
}

model Department {
  id         String    @id
  code       String    @unique
  name       String
  active     Boolean
  orgScope   OrgScope  @map("org_scope")
  districtId String?   @map("district_id")
  branchId   String?   @map("branch_id")
  createdAt  DateTime  @map("created_at")
  updatedAt  DateTime  @map("updated_at")
  findings   Finding[]
  users      User[]

  @@map("departments")
}

model ClassifiedCategory {
  id        String   @id
  code      String   @unique
  name      String
  scored    Boolean
  active    Boolean
  createdAt DateTime @map("created_at")
  updatedAt DateTime @map("updated_at")

  @@map("classified_categories")
}

model UncoveredReason {
  id                  String               @id
  code                String               @unique
  name                String
  active              Boolean
  createdAt           DateTime             @map("created_at")
  updatedAt           DateTime             @map("updated_at")
  branchCoverageNotes BranchCoverageNote[]

  @@map("uncovered_reasons")
}

model ScoringRule {
  id            String   @id
  version       Int
  name          String
  active        Boolean
  everActivated Boolean  @map("ever_activated")
  effectiveFrom DateTime @map("effective_from")
  categories    String[]
  sources       String[]
  basis         String
  formulaType   String   @map("formula_type")
  createdBy     String   @map("created_by")
  createdAt     DateTime @map("created_at")

  @@map("scoring_rules")
}

model ReportingPeriod {
  id                       String               @id
  year                     Int
  month                    Int
  code                     String               @unique
  startsAt                 DateTime             @map("starts_at")
  endsAt                   DateTime             @map("ends_at")
  submissionStartsAt       DateTime             @map("submission_starts_at")
  submissionEndsAt         DateTime             @map("submission_ends_at")
  status                   PeriodStatus
  lockedBy                 String?              @map("locked_by")
  lockedAt                 DateTime?            @map("locked_at")
  lockReason               String?              @map("lock_reason")
  draftsAllowedWhileLocked Boolean              @map("drafts_allowed_while_locked")
  createdAt                DateTime             @map("created_at")
  updatedAt                DateTime             @map("updated_at")
  name                     String?
  branchCoverageNotes      BranchCoverageNote[]
  findings                 Finding[]

  @@map("reporting_periods")
}

model Finding {
  id                     String               @id
  reference              String               @unique
  title                  String
  sourceId               String?              @map("source_id")
  departmentId           String?              @map("department_id")
  periodId               String               @map("period_id")
  districtId             String               @map("district_id")
  branchId               String               @map("branch_id")
  findingDate            String               @map("finding_date")
  operationArea          String               @map("operation_area")
  irregularityType       String               @map("irregularity_type")
  categoryId             String?              @map("category_id")
  amount                 Float
  currency               String
  caseCount              Int                  @map("case_count")
  /// The case count / amount as originally registered - frozen once the finding
  /// is approved; case_count / amount above are the CURRENT figures
  /// (original + approved adjustments, docs/revolving-findings.md).
  registeredCaseCount    Int                  @default(0) @map("registered_case_count")
  registeredAmount       Float                @default(0) @map("registered_amount")
  riskLevel              String               @map("risk_level")
  priority               String
  description            String
  recommendation         String?
  rootCause              String?              @map("root_cause")
  evidenceNote           String?              @map("evidence_note")
  status                 FindingStatus
  rectifiedCases         Int                  @map("rectified_cases")
  rectifiedAmount        Float                @map("rectified_amount")
  closedCases            Int                  @map("closed_cases")
  closedAmount           Float                @map("closed_amount")
  districtVerifiedCases  Int                  @map("district_verified_cases")
  districtVerifiedAmount Float                @map("district_verified_amount")
  externalReference      String?              @map("external_reference")
  importBatchId          String?              @map("import_batch_id")
  lastReminderAt         DateTime?            @map("last_reminder_at")
  createdBy              String               @map("created_by")
  createdAt              DateTime             @map("created_at")
  updatedAt              DateTime             @map("updated_at")
  registeredByBankScope  Boolean              @default(false) @map("registered_by_bank_scope")
  comments               Comment[]
  evidence               Evidence[]
  cases                  FindingCase[]
  closures               FindingClosure[]
  transfers              FindingTransfer[]
  transitions            FindingTransition[]
  branch                 Branch               @relation(fields: [branchId], references: [id])
  department             Department?          @relation(fields: [departmentId], references: [id], onDelete: Restrict)
  district               District             @relation(fields: [districtId], references: [id])
  importBatch            ImportBatch?         @relation(fields: [importBatchId], references: [id])
  period                 ReportingPeriod      @relation(fields: [periodId], references: [id])
  source                 Source?              @relation(fields: [sourceId], references: [id], onDelete: Restrict)
  rectifications         RectificationEntry[]
  adjustments            FindingAdjustment[]

  @@index([periodId])
  @@index([branchId])
  @@index([districtId])
  @@index([status])
  @@index([categoryId])
  @@map("findings")
}

model FindingTransition {
  id         String   @id
  findingId  String   @map("finding_id")
  fromStatus String   @map("from_status")
  toStatus   String   @map("to_status")
  action     String
  userId     String   @map("user_id")
  userName   String   @map("user_name")
  reason     String?
  createdAt  DateTime @map("created_at")
  finding    Finding  @relation(fields: [findingId], references: [id], onDelete: Cascade)

  @@index([findingId])
  @@map("finding_transitions")
}

model RectificationEntry {
  id              String   @id
  findingId       String   @map("finding_id")
  periodId        String   @map("period_id")
  rectifiedCases  Int      @map("rectified_cases")
  rectifiedAmount Float    @map("rectified_amount")
  note            String?
  submittedBy     String   @map("submitted_by")
  submittedByName String   @map("submitted_by_name")
  createdAt       DateTime @map("created_at")
  caseIds         String[] @map("case_ids")
  finding         Finding  @relation(fields: [findingId], references: [id], onDelete: Cascade)

  @@index([findingId])
  @@map("rectifications")
}

model FindingCase {
  id              String            @id
  findingId       String            @map("finding_id")
  seq             Int
  amount          Float
  description     String?
  status          FindingCaseStatus
  rectificationId String?           @map("rectification_id")
  rectifiedAt     DateTime?         @map("rectified_at")
  rectifiedBy     String?           @map("rectified_by")
  rectifiedByName String?           @map("rectified_by_name")
  createdAt       DateTime          @map("created_at")
  finding         Finding           @relation(fields: [findingId], references: [id], onDelete: Cascade)

  @@index([findingId])
  @@map("finding_cases")
}

model FindingTransfer {
  id                    String         @id
  findingId             String         @map("finding_id")
  fromPeriodId          String         @map("from_period_id")
  toPeriodId            String         @map("to_period_id")
  casesTransferred      Int            @map("cases_transferred")
  amountTransferred     Float          @map("amount_transferred")
  originalCaseCount     Int            @map("original_case_count")
  originalAmount        Float          @map("original_amount")
  caseAgeAtTransferDays Int            @map("case_age_at_transfer_days")
  reason                String
  createdBy             String         @map("created_by")
  createdByName         String         @map("created_by_name")
  createdAt             DateTime       @map("created_at")
  method                TransferMethod
  finding               Finding        @relation(fields: [findingId], references: [id], onDelete: Cascade)

  @@index([findingId])
  @@map("finding_transfers")
}

model FindingClosure {
  id              String   @id
  findingId       String   @map("finding_id")
  periodId        String   @map("period_id")
  closedCases     Int      @map("closed_cases")
  closedAmount    Float    @map("closed_amount")
  submittedBy     String   @map("submitted_by")
  submittedByName String   @map("submitted_by_name")
  createdAt       DateTime @map("created_at")
  finding         Finding  @relation(fields: [findingId], references: [id], onDelete: Cascade)

  @@index([findingId])
  @@map("finding_closures")
}

model ImportBatch {
  id             String    @id
  fileName       String    @map("file_name")
  importedBy     String    @map("imported_by")
  importedByName String    @map("imported_by_name")
  totalRows      Int       @map("total_rows")
  importedCount  Int       @map("imported_count")
  duplicateCount Int       @map("duplicate_count")
  errorCount     Int       @map("error_count")
  rows           Json
  createdAt      DateTime  @map("created_at")
  storedFile     String?   @map("stored_file")
  reversedAt     DateTime? @map("reversed_at")
  reversedBy     String?   @map("reversed_by")
  reversedByName String?   @map("reversed_by_name")
  reverseReason  String?   @map("reverse_reason")
  findings       Finding[]

  @@map("import_batches")
}

model Evidence {
  id             String   @id
  findingId      String   @map("finding_id")
  commentId      String?  @map("comment_id")
  fileName       String   @map("file_name")
  mimeType       String   @map("mime_type")
  size           Int
  storagePath    String   @map("storage_path")
  uploadedBy     String   @map("uploaded_by")
  uploadedByName String   @map("uploaded_by_name")
  createdAt      DateTime @map("created_at")
  comment        Comment? @relation(fields: [commentId], references: [id])
  finding        Finding  @relation(fields: [findingId], references: [id], onDelete: Cascade)

  @@index([findingId])
  @@map("evidence")
}

model Comment {
  id              String     @id
  findingId       String     @map("finding_id")
  parentCommentId String?    @map("parent_comment_id")
  authorId        String     @map("author_id")
  authorName      String     @map("author_name")
  text            String
  createdAt       DateTime   @map("created_at")
  finding         Finding    @relation(fields: [findingId], references: [id], onDelete: Cascade)
  parent          Comment?   @relation("CommentReplies", fields: [parentCommentId], references: [id], onDelete: Cascade)
  replies         Comment[]  @relation("CommentReplies")
  evidence        Evidence[]

  @@index([findingId])
  @@map("comments")
}

model Notification {
  id              String    @id
  recipientUserId String    @map("recipient_user_id")
  type            String
  title           String
  message         String
  entityType      String    @map("entity_type")
  entityId        String    @map("entity_id")
  readAt          DateTime? @map("read_at")
  createdAt       DateTime  @map("created_at")

  @@index([recipientUserId])
  @@map("notifications")
}

model AuditLogEntry {
  id           String   @id
  userId       String   @map("user_id")
  userName     String   @map("user_name")
  action       String
  entityType   String   @map("entity_type")
  entityId     String   @map("entity_id")
  oldValue     Json?    @map("old_value")
  newValue     Json?    @map("new_value")
  reason       String?
  timestamp    DateTime
  sequence     BigInt   @unique @map("sequence")
  previousHash String   @map("previous_hash")
  hash         String   @map("hash")

  @@index([entityType, entityId])
  @@map("audit_logs")
}

model BranchCoverageNote {
  id             String           @id
  branchId       String           @map("branch_id")
  periodId       String           @map("period_id")
  reason         String
  reasonId       String?          @map("reason_id")
  recordedBy     String           @map("recorded_by")
  recordedByName String           @map("recorded_by_name")
  createdAt      DateTime         @map("created_at")
  updatedAt      DateTime         @map("updated_at")
  branch         Branch           @relation(fields: [branchId], references: [id], onDelete: Cascade)
  period         ReportingPeriod  @relation(fields: [periodId], references: [id], onDelete: Cascade)
  reasonRef      UncoveredReason? @relation(fields: [reasonId], references: [id])

  @@unique([branchId, periodId])
  @@map("branch_coverage_notes")
}

model Settings {
  id                           String   @id @default("singleton")
  currencies                   String[]
  riskLevels                   String[] @map("risk_levels")
  operationAreas               String[] @map("operation_areas")
  priorityLevels               String[] @map("priority_levels")
  irregularityTypes            String[] @map("irregularity_types")
  notification                 Json
  rankingVisibility            Json     @map("ranking_visibility")
  performanceThresholds        Json     @map("performance_thresholds")
  hoApproval                   Json     @map("ho_approval")
  rectificationReminders       Json     @map("rectification_reminders")
  similarFindingFields         String[] @map("similar_finding_fields")
  requiredFindingFields        Json     @map("required_finding_fields")
  allowOtherValueFields        Json     @map("allow_other_value_fields")
  permissionRegistrySyncedKeys String[] @map("permission_registry_synced_keys")
  updatedAt                    DateTime @map("updated_at")
  updatedBy                    String?  @map("updated_by")
  reportTemplateSources        Json     @default("{}") @map("report_template_sources")

  @@map("settings")
}

model SupportThread {
  id        String              @id
  userId    String              @map("user_id")
  subject   String
  status    SupportThreadStatus @default(OPEN)
  rating    Int?
  createdAt DateTime            @map("created_at")
  updatedAt DateTime            @map("updated_at")
  messages  SupportMessage[]
  user      User                @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([userId])
  @@map("support_threads")
}

model SupportMessage {
  id              String        @id
  threadId        String        @map("thread_id")
  senderId        String        @map("sender_id")
  senderName      String        @map("sender_name")
  senderIsSupport Boolean       @map("sender_is_support")
  body            String
  createdAt       DateTime      @map("created_at")
  thread          SupportThread @relation(fields: [threadId], references: [id], onDelete: Cascade)

  @@index([threadId])
  @@map("support_messages")
}

enum Status {
  ACTIVE
  INACTIVE
}

enum OrgScope {
  BANK
  DISTRICT
  BRANCH
}

enum PeriodStatus {
  OPEN
  LOCKED
}

enum FindingStatus {
  DRAFT
  SUBMITTED
  DISTRICT_REVIEW
  DISTRICT_APPROVED
  HO_REVIEW
  HO_APPROVED
  PENDING_BANK_APPROVAL
  SENT_TO_BRANCH_MANAGER
  REVERSED
  PARTIALLY_RECTIFIED
  RECTIFIED
  TRANSFERRED
  RECTIFICATION_RETURNED
  REJECTED
  RETURNED
  CLOSED
}

enum FindingCaseStatus {
  OUTSTANDING
  RECTIFIED
}

enum TransferMethod {
  MANUAL
  AUTOMATIC
}

enum ImportOutcome {
  imported
  duplicate
  error
}

enum SupportThreadStatus {
  OPEN
  RESOLVED
}

/// Automatic transfer at period end (src/lib/autoTransfer): its own settings, one row.
model AutoTransferConfig {
  id                     String   @id @default("singleton")
  enabled                Boolean  @default(true)
  excludedOperationAreas String[] @default([]) @map("excluded_operation_areas")
  delayHours             Int      @default(0) @map("delay_hours")
  updatedAt              DateTime @default(now()) @map("updated_at")
  updatedBy              String?  @map("updated_by")

  @@map("auto_transfer_config")
}

/// Automatic transfer at period end: one row per reporting period it handled
/// (status DONE | WAITING_NO_NEXT | SKIPPED_AT_RELEASE). Deliberately no
/// foreign key - the module stays independent of the period table.
model AutoTransferRun {
  periodId        String   @id @map("period_id")
  status          String
  toPeriodId      String?  @map("to_period_id")
  movedCount      Int      @default(0) @map("moved_count")
  keptCount       Int      @default(0) @map("kept_count")
  movedReferences String[] @default([]) @map("moved_references")
  keptReferences  String[] @default([]) @map("kept_references")
  ranAt           DateTime @map("ran_at")
  /// What started the sweep: "scheduler" (POST /api/system/auto-transfer) or "in-app" (the check made while people use the app). Null for older rows.
  triggeredBy     String?  @map("triggered_by")

  @@map("auto_transfer_runs")
}

/// Revolving findings (docs/revolving-findings.md): an approved-or-pending
/// change to a finding's outstanding cases / amount. The original
/// registration is never edited; the finding's current figures are original
/// + approved adjustments.
model FindingAdjustment {
  id                String   @id
  findingId         String   @map("finding_id")
  /// The period it was submitted (reported) in.
  periodId          String   @map("period_id")
  /// DRAFT | DISTRICT_REVIEW | HO_REVIEW | PENDING_BANK_APPROVAL | APPROVED | RETURNED | REJECTED | WITHDRAWN
  status            String
  addedCases        Int      @default(0) @map("added_cases")
  /// Non-itemized: the amount change (+/-). Itemized: derived from the case amounts.
  amountChange      Float    @default(0) @map("amount_change")
  /// Itemized findings: amounts of the added cases, and changes to outstanding cases ([{caseId, from, to}]).
  newCaseAmounts    Float[]  @default([]) @map("new_case_amounts")
  caseAmountChanges Json     @default("[]") @map("case_amount_changes")
  reason            String
  requestedBy       String   @map("requested_by")
  requestedByName   String   @map("requested_by_name")
  /// The requester's level: BANK (bank-wide approval path) or BRANCH/DISTRICT (district -> HO path).
  requesterScope    String   @map("requester_scope")
  submittedAt       DateTime? @map("submitted_at")
  approvedAt        DateTime? @map("approved_at")
  /// Every decision: [{step, decision, by, byName, at, reason}].
  decisions         Json     @default("[]")
  /// Before / after figures, recorded when applied.
  applied           Json?
  createdAt         DateTime @map("created_at")
  updatedAt         DateTime @map("updated_at")
  finding           Finding  @relation(fields: [findingId], references: [id], onDelete: Cascade)

  @@index([findingId])
  @@index([status])
  @@map("finding_adjustments")
}

/// Revolving findings: which operation areas allow adjustments (one row).
model AdjustmentConfig {
  id                       String   @id @default("singleton")
  revolvingOperationAreas  String[] @default([]) @map("revolving_operation_areas")
  updatedAt                DateTime @default(now()) @map("updated_at")
  updatedBy                String?  @map("updated_by")

  @@map("adjustment_config")
}

/// Email queue (docs/email-queue.md): one row per email to send, written in
/// the same transaction as the notification that caused it, delivered by the
/// worker (src/lib/emailQueue) with retries. Not part of the Database model.
model EmailOutbox {
  id               String    @id
  /// NOTIFICATION (the only queued kind today).
  kind             String    @default("NOTIFICATION")
  notificationId   String?   @map("notification_id")
  notificationType String?   @map("notification_type")
  recipientUserId  String?   @map("recipient_user_id")
  toAddress        String    @map("to_address")
  fromAddress      String    @map("from_address")
  subject          String
  bodyText         String    @map("body_text")
  bodyHtml         String    @map("body_html")
  /// Stops the same email being queued twice (e.g. "notification:<id>").
  dedupeKey        String    @unique @map("dedupe_key")
  /// PENDING | SENDING | SENT | FAILED | CANCELLED
  status           String    @default("PENDING")
  priority         Int       @default(0)
  attempts         Int       @default(0)
  maxAttempts      Int       @default(6) @map("max_attempts")
  nextAttemptAt    DateTime  @default(now()) @map("next_attempt_at")
  /// Not sent after this moment (a stale email is worse than none).
  expiresAt        DateTime? @map("expires_at")
  lockedAt         DateTime? @map("locked_at")
  lockedBy         String?   @map("locked_by")
  /// Short and sanitized; the full error is in the server log only.
  lastError        String?   @map("last_error")
  smtpMessageId    String?   @map("smtp_message_id")
  sentAt           DateTime? @map("sent_at")
  createdAt        DateTime  @default(now()) @map("created_at")

  @@index([status, nextAttemptAt, priority])
  @@index([notificationId])
  @@index([createdAt])
  @@map("email_outbox")
}

/// Email queue: pause switch and last worker run (one row).
model EmailQueueState {
  id           String    @id @default("singleton")
  paused       Boolean   @default(false)
  pausedReason String?   @map("paused_reason")
  pausedAt     DateTime? @map("paused_at")
  pausedBy     String?   @map("paused_by")
  lastRunAt    DateTime? @map("last_run_at")
  lastRunBy    String?   @map("last_run_by")

  @@map("email_queue_state")
}

/// Rectification reminders (docs/rectification-reminders.md): one row per
/// run. The scheduled run's id is its local date ("2026-10-10"), so a day
/// can never be run twice; a manual "run now" gets its own id.
model ReminderRun {
  id               String   @id
  /// Local date of the run, YYYY-MM-DD.
  runDate          String   @map("run_date")
  ranAt            DateTime @map("ran_at")
  /// "scheduler" | "in-app" | "manual"
  triggeredBy      String   @map("triggered_by")
  remindedFindings Int      @default(0) @map("reminded_findings")
  notifiedUsers    Int      @default(0) @map("notified_users")
  findingReferences String[] @default([]) @map("finding_references")

  @@index([ranAt])
  @@map("reminder_runs")
}

{
  "name": "auditapp",
  "version": "0.1.0",
  "private": true,
  "scripts": {
    "postinstall": "prisma generate",
    "dev": "node scripts/run.mjs dev",
    "build": "next build --webpack",
    "start": "node scripts/run.mjs start",
    "lint": "eslint",
    "db:seed": "tsx prisma/seed.ts",
    "storage:migrate": "tsx scripts/storage-migrate.ts",
    "storage:cleanup": "tsx scripts/storage-cleanup.ts",
    "storage:export": "tsx scripts/storage-export.ts",
    "tunnel": "node scripts/run.mjs tunnel",
    "tunnel:cloudflare": "node scripts/run.mjs tunnel:cloudflare",
    "test": "vitest run",
    "test:watch": "vitest",
    "reports:verify": "tsx --env-file=.env --env-file-if-exists=.env.local scripts/verify-report-templates.ts",
    "worker:email": "tsx --env-file=.env --env-file-if-exists=.env.local scripts/email-worker.ts"
  },
  "dependencies": {
    "@emotion/cache": "^11.14.0",
    "@emotion/react": "^11.14.0",
    "@emotion/styled": "^11.14.1",
    "@mui/icons-material": "^9.5.0",
    "@mui/material": "^9.5.0",
    "@mui/material-nextjs": "^9.5.0",
    "@mui/x-date-pickers": "^9.15.0",
    "@prisma/adapter-pg": "^7.10.1",
    "@prisma/client": "^7.10.1",
    "@sentry/nextjs": "^11.8.0",
    "bcryptjs": "^3.0.3",
    "bullmq": "^6.3.15",
    "exceljs": "^4.4.0",
    "ioredis": "^6.0.0",
    "iron-session": "^9.0.1",
    "lucide-react": "^1.58.0",
    "material-react-table": "^3.2.1",
    "next": "16.3.8",
    "nodemailer": "^10.1.1",
    "pino": "^10.4.0",
    "prisma": "^7.10.1",
    "react": "19.3.1",
    "react-dom": "19.3.1",
    "sonner": "^2.0.8",
    "uuid": "^14.0.3",
    "zod": "^4.6.7"
  },
  "devDependencies": {
    "@tailwindcss/postcss": "^4",
    "@testing-library/dom": "^10.4.2",
    "@testing-library/react": "^16.3.3",
    "@types/bcryptjs": "^2.4.6",
    "@types/node": "^24.19.2",
    "@types/nodemailer": "^8.0.2",
    "@types/react": "^19.3.0",
    "@types/react-dom": "^19.3.0",
    "@types/uuid": "^10.0.0",
    "cloudflared": "^0.7.3",
    "dotenv": "^18.0.8",
    "eslint": "^9.39.5",
    "eslint-config-next": "16.3.8",
    "jsdom": "^29.1.1",
    "localtunnel": "^2.0.2",
    "tailwindcss": "^4",
    "tsx": "^4.23.15",
    "typescript": "^6.0.3",
    "vitest": "^5.0.5"
  },
  "allowScripts": {
    "@prisma/engines@7.10.1": true,
    "prisma@7.10.1": true
  },
  "overrides": {
    "exceljs": {
      "uuid": "^14.0.2"
    },
    "@next/eslint-plugin-next": {
      "fast-glob": "npm:tinyglobby@^0.2.17"
    },
    "localtunnel": {
      "axios": "^0.34.0"
    }
  }
}

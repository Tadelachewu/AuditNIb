IRON_SESSION_PASSWORD=replace-with-a-random-string-at-least-32-characters-long

# Postgres connection string (Prisma). Read by the app itself (via
# src/lib/prismaClient.ts's driver adapter) and, separately, by the `prisma`
# CLI via prisma.config.ts for `generate`/`migrate`/`studio` - both need it,
# neither reads it from prisma/schema.prisma any more (Prisma 7).
DATABASE_URL=postgresql://user:password@localhost:5432/auditapp?schema=public

# Redis (or a Redis-protocol-compatible server, e.g. Memurai on Windows) -
# backs login/password-change rate limiting and lockout (src/lib/rateLimit.ts).
# Required: an in-memory fallback would reset on every restart and wouldn't
# work correctly across more than one server instance.
REDIS_URL=redis://localhost:6379

# Session cookie `Secure` flag.
#   - Default behavior (leave unset): true if NODE_ENV=production, else false.
#   - Set "true" explicitly to force Secure cookies even if NODE_ENV isn't
#     "production" but you're behind an HTTPS-terminating reverse proxy.
#   - Set "false" to explicitly disable (e.g. accessing the prod build over
#     plain HTTP on a trusted LAN) — only use this if you know what you're
#     doing; disabling Secure over the public internet exposes the session
#     cookie to passive network sniffing.
SESSION_COOKIE_SECURE=true

# Session idle timeout — a user with no activity (no page/API request) for
# this many minutes will be forcibly signed out. Each activity refreshes the
# idle clock (sliding window). Applied server-side; the cookie's own Max-Age
# is set to the absolute timeout below as a browser-level safety net.
# Default: 30 minutes
SESSION_IDLE_TIMEOUT_MINUTES=30

# Session absolute timeout — regardless of activity, a session is forcibly
# terminated this many hours after it was created (login / password change
# / session reissue). A fresh login is required beyond this point.
# Default: 8 hours
SESSION_ABSOLUTE_TIMEOUT_HOURS=8

# Only needed when Settings > Notification Delivery > Provider is set to
# SMTP relay. Credentials, unlike host/port/from-address, never belong in
# the JSON-backed Settings object - see EMAIL_SETUP.md.
SMTP_USER=
SMTP_PASSWORD=

# The app's own public https:// origin (no trailing slash), e.g.
# https://nibprocure.nibbank.com.et. Used only to build the "Open in NIB
# Control360" link in notification emails (src/lib/mail.ts's
# sendNotificationEmail()) - that code runs deep inside a database
# transaction with no incoming request to read a Host header from, unlike
# /api/auth/forgot-password's own per-request buildPublicOrigin(). Leave
# unset to omit the link (email still sends, just without it).
APP_BASE_URL=

# --- File storage (docs/files.md) ---
# Encrypts every stored upload (evidence, comment attachments, import files)
# at rest with AES-256-GCM. REQUIRED for uploads to work. Generate once with:
#   node -e "console.log(require('crypto').randomBytes(32).toString('base64'))"
# Keep it secret and back it up separately from the files: without this exact
# key the stored files cannot be read. Never change it once files exist.
FILE_ENCRYPTION_KEY=
# Where uploads are stored. Default: ./storage next to the app. Point it at a
# dedicated disk/volume, or a network share mounted on every server when
# running more than one app server.
STORAGE_DIR=

# --- Environment (docs/reset-data.md) ---
# "development" marks this server as a development/test environment:
# ENABLES the /dev-reset tool (permanently deletes all findings), shows the
# seeded demo accounts on the login page, and seeds accounts WITHOUT a forced
# password change. See docs/PRODUCTION.md. Any
# other value - or leaving it unset - disables it. Keep "production" on any
# server with real data. Independent of `npm run dev` vs a built app; restart
# the app after changing it (no rebuild needed).
APP_ENV=production

# --- Server port ---
# Port for `npm run dev`, `npm start` and the tunnel scripts (scripts/run.mjs).
# Default 9005. A PORT set in the real environment wins over this file.
PORT=9005
# Optional address to bind: 0.0.0.0 = reachable from the network,
# 127.0.0.1 = this machine only (e.g. behind a reverse proxy). Blank = Next default.
HOST=
